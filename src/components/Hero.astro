---
import { perfil } from '../data/perfil';
import CodeWindow from './CodeWindow.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="relative isolate overflow-hidden">
  <!-- brilho decorativo de fundo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[28rem] w-[46rem] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
  ></div>

  <div class="mx-auto grid max-w-5xl items-center gap-12 px-5 py-20 sm:py-28 lg:grid-cols-[1.15fr_1fr]">
    <div class="min-w-0 motion-safe:animate-fade-up">
      <p class="inline-block rounded-full border border-border bg-surface px-3 py-1 text-xs tracking-wide text-muted">
        {perfil.local}
      </p>
      <h1 class="mt-5 text-5xl leading-[1.05] font-extrabold tracking-tight sm:text-6xl">
        Olá, eu sou{' '}
        <span class="bg-linear-to-r from-accent to-accent-2 bg-clip-text text-transparent">Lucas</span>.
      </h1>
      <p class="mt-3 text-xl font-medium text-text/90">{perfil.cargo}</p>
      <p class="mt-5 max-w-prose text-lg text-muted">{perfil.valor}</p>
      <p class="mt-3 font-mono text-sm text-accent-2">{perfil.subtitulo}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projetos"
          class="rounded-lg bg-accent px-5 py-2.5 font-semibold text-bg transition hover:brightness-110"
        >
          Ver projetos
        </a>
        <a
          href={perfil.cv}
          download
          class="rounded-lg border border-border px-5 py-2.5 font-semibold transition hover:border-accent hover:text-accent"
        >
          Baixar CV
        </a>
      </div>
      <div class="mt-6">
        <SocialLinks />
      </div>
    </div>
    <div class="min-w-0 motion-safe:animate-fade-up [animation-delay:150ms]">
      <CodeWindow />
    </div>
  </div>
</section>

---
import { perfil } from '../data/perfil';
import PillLink from './PillLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="hero">
  <div class="container">
    <p class="local">{perfil.local}</p>
    <h1>{perfil.nome}</h1>
    <p class="cargo">{perfil.cargo}</p>
    <p class="valor">{perfil.valor}</p>
    <div class="acoes">
      <PillLink href={perfil.cv} icone="tabler:download" primario baixar>
        Baixar currículo
      </PillLink>
      <SocialLinks />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 4.5rem 4rem;
  }

  .local {
    color: var(--suave);
    font-size: 0.95rem;
  }

  h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cargo {
    margin-top: 0.5rem;
    font-size: 1.35rem;
    color: var(--destaque);
  }

  .valor {
    margin-top: 1.25rem;
    max-width: 38rem;
    font-size: 1.15rem;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }
</style>

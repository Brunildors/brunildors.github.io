---
import { perfil } from '../data/perfil';
import CodeWindow from './CodeWindow.astro';
import SocialLinks from './SocialLinks.astro';
---

<section class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-16 sm:py-24 lg:grid-cols-2">
  <div>
    <p class="mb-3 font-mono text-sm text-accent">&gt; Olá, eu sou</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      {perfil.nome}
      <span class="caret ml-1 inline-block w-[0.5ch] bg-accent align-baseline" aria-hidden="true">
        &nbsp;
      </span>
    </h1>
    <p class="mt-3 text-xl text-accent-2">{perfil.cargo}</p>
    <p class="mt-1 font-mono text-sm text-muted">{perfil.subtitulo}</p>
    <p class="mt-6 max-w-prose text-lg text-text/90">{perfil.valor}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#projetos"
        class="rounded-lg bg-accent px-5 py-2.5 font-semibold text-bg transition hover:brightness-110"
      >
        Ver projetos
      </a>
      <a
        href={perfil.cv}
        download
        class="rounded-lg border border-border px-5 py-2.5 font-semibold transition hover:border-accent hover:text-accent"
      >
        Baixar CV
      </a>
    </div>
    <div class="mt-6">
      <SocialLinks />
    </div>
  </div>
  <CodeWindow />
</section>

<style>
  .caret {
    animation: piscar 1.1s steps(1) infinite;
  }
  @keyframes piscar {
    50% {
      opacity: 0;
    }
  }
</style>

---
import { perfil } from '../data/perfil';
import PillLink from './PillLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<p class="chamada">
  Se quiser falar sobre um projeto, uma vaga ou só trocar uma ideia, escolha o canal que preferir.
</p>

<div class="botoes">
  <SocialLinks detalhes />
  <PillLink href={perfil.cv} icone="tabler:download" baixar>
    Baixar currículo
  </PillLink>
</div>

<style>
  .chamada {
    max-width: 34rem;
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
</style>

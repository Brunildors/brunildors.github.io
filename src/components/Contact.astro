---
import { perfil } from '../data/perfil';
import SocialLinks from './SocialLinks.astro';
---

<div class="rounded-xl border border-border bg-surface p-6 font-mono">
  <p class="text-muted">$ ./contato.sh</p>
  <p class="mt-3 font-sans text-lg">Vamos conversar sobre um projeto, uma vaga ou uma ideia?</p>
  <p class="mt-4 text-sm">
    <span class="text-muted">email:</span>
    {perfil.email ? (
      <a href={`mailto:${perfil.email}`} class="text-accent underline-offset-4 hover:underline">
        {perfil.email}
      </a>
    ) : (
      <span class="text-accent-2">[TODO: e-mail público]</span>
    )}
  </p>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <SocialLinks comRotulo />
    <a
      href={perfil.cv}
      download
      class="rounded-lg border border-accent px-4 py-2 text-sm text-accent transition hover:bg-accent hover:text-bg"
    >
      Baixar CV
    </a>
  </div>
</div>

---
interface Props {
  num: string;
  titulo: string;
  id: string;
}
const { num, titulo, id } = Astro.props;
---

<div class="mb-10">
  <p class="font-mono text-sm text-accent" aria-hidden="true">
    {num}
  </p>
  <h2 id={id} class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">
    {titulo}
  </h2>
</div>

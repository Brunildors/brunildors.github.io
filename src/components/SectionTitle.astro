---
interface Props {
  num: string;
  titulo: string;
  id: string;
}
const { num, titulo, id } = Astro.props;
---

<h2 id={id} class="mb-8 font-mono text-2xl font-semibold text-text sm:text-3xl">
  <span class="text-muted" aria-hidden="true">
    // {num}.
  </span>
  <span class="text-accent">{titulo}</span>
</h2>

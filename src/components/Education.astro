---
import { textos, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { formacao, cursos } = textos(lang);
---

<div class="paineis">
  <section class="painel" data-revelar aria-labelledby="titulo-formacao">
    <h3 id="titulo-formacao">{formacao.titulo}</h3>
    <ul>
      {formacao.itens.map((f) => (
        <li>
          <p class="curso">{f.curso}</p>
          <p>{f.instituicao}</p>
          <p class="mono suave">
            {f.periodo} · {f.status}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="painel" data-revelar style="--ordem: 1" aria-labelledby="titulo-cursos">
    <h3 id="titulo-cursos">{cursos.titulo}</h3>
    <ul>
      {cursos.itens.map((c) => (
        <li>
          <p class="curso">{c.nome}</p>
          <p class="mono suave">{c.plataforma}</p>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .paineis {
    display: grid;
    gap: 1.5rem;
  }

  h3 {
    margin-bottom: 1.25rem;
    color: var(--prata);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 1.25rem;
  }

  .curso {
    color: var(--prata-2);
    font-weight: 600;
  }

  @media (min-width: 52rem) {
    .paineis {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>

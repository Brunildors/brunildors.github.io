---
interface Props {
  id: string;
  titulo: string;
}
const { id, titulo } = Astro.props;
---

<section {id} class="secao" data-secao aria-labelledby={`${id}-titulo`}>
  <!-- O corte de lâmina no topo marca onde uma seção termina e a próxima começa. -->
  <span class="lamina" aria-hidden="true"></span>
  <div class="container">
    <h2 id={`${id}-titulo`} class="titulo-secao">
      {titulo}
    </h2>
    <slot />
  </div>
</section>

<style>
  .secao {
    padding-block: 0 5rem;
    background-color: var(--grafite);
    background-image: var(--ruido);
  }

  /* Fundos alternados: o degrau de tom também mostra a troca de seção. */
  .secao:nth-of-type(even) {
    background-color: var(--grafite-2);
  }

  .lamina {
    height: 3px;
  }

  .titulo-secao {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-block: 3.25rem 2.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .titulo-secao::before {
    content: '';
    width: 0.55rem;
    height: 1.7rem;
    background: var(--bordo-2);
    clip-path: polygon(0 0, 100% 0, 100% 70%, 0 100%);
  }
</style>

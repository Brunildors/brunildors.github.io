---
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  titulo: string;
  resumo: string;
  stack: string[];
  ordem: number;
  destaque?: boolean;
  capa?: ImageMetadata;
}
const { slug, titulo, resumo, stack, ordem, destaque = false, capa } = Astro.props;
---

<a
  href={`/projetos/${slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface transition hover:border-accent/60 motion-safe:hover:-translate-y-1"
>
  {capa ? (
    <Image
      src={capa}
      alt=""
      layout="constrained"
      width={800}
      height={450}
      class="aspect-video w-full object-cover"
    />
  ) : (
    <div
      class="relative flex aspect-video items-center justify-center bg-linear-to-br from-accent/15 via-surface to-accent-2/20"
      aria-hidden="true"
    >
      <span class="font-mono text-6xl font-bold text-text/15">{String(ordem).padStart(2, '0')}</span>
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    {destaque && (
      <span class="mb-2 w-fit rounded-full border border-accent-2/50 px-2.5 py-0.5 text-xs text-accent-2">
        Destaque
      </span>
    )}
    <h3 class="text-lg font-semibold transition group-hover:text-accent">{titulo}</h3>
    <p class="mt-2 flex-1 text-sm text-muted">{resumo}</p>
    <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-accent">
      {stack.map((t) => (
        <li class="rounded bg-bg px-2 py-1">{t}</li>
      ))}
    </ul>
  </div>
</a>

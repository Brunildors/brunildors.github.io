---
import { Icon } from 'astro-icon/components';
import { rotaProjeto, textos, type Lang } from '../i18n';
import type { ProjetoPublicado } from '../data/projetos';
import CapaProjeto from './CapaProjeto.astro';
import PillLink from './PillLink.astro';

interface Props {
  lang: Lang;
  projeto: ProjetoPublicado;
  /** Card grande, em duas colunas, para o projeto principal. */
  destaque?: boolean;
  /** Posição na vitrine, para escalonar a entrada. */
  ordem?: number;
}

const { lang, projeto, destaque = false, ordem = 0 } = Astro.props;
const t = textos(lang);
const { slug, dados, texto } = projeto;
const { titulo, resumo, demoRotulo, capaAlt } = texto.data;
const pagina = rotaProjeto(lang, slug);
---

<article class:list={['card', 'painel', { destaque }]} data-revelar style={`--ordem: ${ordem}`}>
  <div class="visual">
    {dados.capa ? (
      <CapaProjeto
        capa={dados.capa}
        alt={capaAlt ?? `${t.projetos.telaDoProjeto} ${titulo}`}
        ajuste={dados.capaAjuste}
        largura={destaque ? 640 : 480}
      />
    ) : (
      <div class="emblema">
        <Icon name={dados.icone} size={destaque ? 56 : 44} aria-hidden="true" />
      </div>
    )}
  </div>

  <div class="texto">
    {destaque && <p class="selo">{t.projetos.destaque}</p>}
    <h3>
      <a href={pagina}>{titulo}</a>
    </h3>
    <p class="resumo">{resumo}</p>
    <p class="tec mono suave">{dados.stack.join(' · ')}</p>
    <div class="botoes">
      {dados.demo && (
        <PillLink href={dados.demo} icone="tabler:player-play" primario>
          {demoRotulo}
        </PillLink>
      )}
      {dados.repositorio && (
        <PillLink href={dados.repositorio} icone="tabler:brand-github">
          {t.projetos.codigoGithub}
        </PillLink>
      )}
      <PillLink href={pagina} icone="tabler:arrow-right">
        {t.projetos.detalhes}
      </PillLink>
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.25rem;
    height: 100%;
    padding: 0;
    transition: background-color 0.2s;
  }

  .card:hover {
    background: linear-gradient(160deg, var(--vinho), var(--grafite-2));
  }

  /* Projeto sem capa: emblema sobre a trama de empunhadura. */
  .emblema {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--tsuka-ito);
    color: var(--prata-2);
  }

  .texto {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 0 1.5rem 1.5rem;
  }

  .selo {
    width: fit-content;
    padding: 0.2rem 0.7rem;
    background: var(--bordo-2);
    color: var(--prata-2);
    font-family: var(--fonte-display), system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  h3 a {
    color: var(--prata-2);
    text-decoration: none;
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  @media (min-width: 52rem) {
    .destaque {
      grid-template-columns: 1.15fr 1fr;
      gap: 0;
    }

    /* No card grande a imagem acompanha a altura do texto. */
    .destaque .visual :global(.capa),
    .destaque .emblema {
      height: 100%;
      aspect-ratio: auto;
    }

    .destaque .texto {
      padding: 2rem 2rem 2rem 2.25rem;
      align-content: center;
    }

    .destaque h3 {
      font-size: 1.7rem;
    }
  }
</style>

---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import PillLink from './PillLink.astro';

interface Props {
  slug: string;
  titulo: string;
  resumo: string;
  stack: string[];
  icone: string;
  /** Card grande, em duas colunas, para o projeto principal. */
  destaque?: boolean;
  capa?: ImageMetadata;
  repositorio?: string;
  demo?: string;
  /** Posição na vitrine, para escalonar a entrada. */
  ordem?: number;
}

const {
  slug,
  titulo,
  resumo,
  stack,
  icone,
  destaque = false,
  capa,
  repositorio,
  demo,
  ordem = 0,
} = Astro.props;
const largura = destaque ? 640 : 480;
---

<article class:list={['card', 'painel', { destaque }]} data-revelar style={`--ordem: ${ordem}`}>
  <div class="visual">
    {capa ? (
      <Image
        src={capa}
        alt={`Tela do projeto ${titulo}`}
        width={largura}
        height={Math.round((largura * capa.height) / capa.width)}
      />
    ) : (
      <Icon name={icone} size={destaque ? 56 : 44} aria-hidden="true" />
    )}
  </div>

  <div class="texto">
    {destaque && <p class="selo">Projeto em destaque</p>}
    <h3>
      <a href={`/projetos/${slug}`}>{titulo}</a>
    </h3>
    <p class="resumo">{resumo}</p>
    <p class="tec mono suave">{stack.join(' · ')}</p>
    <div class="botoes">
      {demo && (
        <PillLink href={demo} icone="tabler:player-play" primario>
          Jogar
        </PillLink>
      )}
      {repositorio && (
        <PillLink href={repositorio} icone="tabler:brand-github">
          Código no GitHub
        </PillLink>
      )}
      <PillLink href={`/projetos/${slug}`} icone="tabler:arrow-right">
        Detalhes
      </PillLink>
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.25rem;
    height: 100%;
    padding: 0;
    border-top: 0;
    transition: background-color 0.2s;
  }

  .card:hover {
    background: linear-gradient(160deg, var(--vinho), var(--grafite-2));
  }

  /* Área da imagem ou do emblema, com a trama de empunhadura como fundo. */
  .visual {
    display: grid;
    place-items: center;
    min-height: 9rem;
    background: var(--tsuka-ito);
    color: var(--prata-2);
  }

  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .texto {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 0 1.5rem 1.5rem;
  }

  .selo {
    width: fit-content;
    padding: 0.2rem 0.7rem;
    background: var(--bordo-2);
    color: var(--prata-2);
    font-family: var(--fonte-display), system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  h3 a {
    color: var(--prata-2);
    text-decoration: none;
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  @media (min-width: 52rem) {
    .destaque {
      grid-template-columns: 1.15fr 1fr;
      gap: 0;
    }

    .destaque .visual {
      min-height: 100%;
    }

    .destaque .texto {
      padding: 2rem 2rem 2rem 2.25rem;
      align-content: center;
    }

    .destaque h3 {
      font-size: 1.7rem;
    }
  }
</style>

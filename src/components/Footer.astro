---
import { perfil } from '../data/perfil';
import PillLink from './PillLink.astro';
---

<footer>
  <span class="lamina-fixa" aria-hidden="true"></span>
  <div class="container linha">
    <p class="mono suave">
      © {new Date().getFullYear()} {perfil.nome} · {perfil.local}
    </p>
    <PillLink href={perfil.repositorio} icone="tabler:brand-github">
      Código deste site
    </PillLink>
  </div>
</footer>

<style>
  footer {
    background-color: var(--grafite);
    background-image: var(--ruido);
  }

  .lamina-fixa {
    display: block;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--bordo-2) 0 7rem,
      var(--prata) 7rem,
      rgb(175 170 169 / 0.18) 75%,
      transparent
    );
  }

  .linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
  }
</style>

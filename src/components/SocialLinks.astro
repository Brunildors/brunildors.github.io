---
import PillLink from './PillLink.astro';
import { contatos } from '../data/redes';
---

<ul class="lista">
  {contatos.map((c) => (
    <li>
      <PillLink href={c.url} icone={c.icone}>
        {c.nome}
      </PillLink>
    </li>
  ))}
</ul>

<style>
  .lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>

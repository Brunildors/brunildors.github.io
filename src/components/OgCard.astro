---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { perfil } from '../data/perfil';
import { textos, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = textos(lang);
---

<!-- Página interna: scripts/gerar-assets.mjs tira um print dela (1200x630) e salva em public/og-image*.png -->
<html lang={t.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
    <Font cssVariable="--fonte-display" />
    <Font cssVariable="--fonte-texto" />
    <Font cssVariable="--fonte-mono" />
  </head>
  <body>
    <div class="cartao">
      <p class="mono suave local">{t.perfil.local}</p>
      <h1>{perfil.nome}</h1>
      <p class="cargo">{t.perfil.cargo}</p>
      <span class="lamina" aria-hidden="true"></span>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  .cartao {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 1200px;
    height: 630px;
    padding: 0 96px;
    border-left: 18px solid var(--bordo-2);
  }

  .local {
    font-size: 28px;
  }

  h1 {
    margin-top: 14px;
    font-size: 82px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .cargo {
    margin-top: 14px;
    color: var(--prata);
    font-family: var(--fonte-display), system-ui, sans-serif;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .lamina {
    width: 520px;
    height: 4px;
    margin-top: 36px;
  }
</style>

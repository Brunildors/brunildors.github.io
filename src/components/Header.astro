---
import { perfil } from '../data/perfil';

const links = [
  { href: '/#sobre', rotulo: 'Sobre' },
  { href: '/#projetos', rotulo: 'Projetos' },
  { href: '/#experiencia', rotulo: 'Experiência' },
  { href: '/#contato', rotulo: 'Contato' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-5 py-3">
    <a href="/" class="text-lg font-bold tracking-tight" aria-label="Início">
      Lucas<span class="text-accent">.</span>dev
    </a>
    <nav aria-label="Principal" class="order-3 w-full sm:order-none sm:w-auto">
      <ul class="flex gap-1 text-sm text-muted">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-md px-3 py-1.5 transition hover:bg-surface hover:text-text">
              {l.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href={perfil.cv}
      download
      class="rounded-lg border border-accent px-3.5 py-1.5 text-sm font-medium text-accent transition hover:bg-accent hover:text-bg"
    >
      Baixar CV
    </a>
  </div>
</header>

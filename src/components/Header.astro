---
import { perfil } from '../data/perfil';

const links = [
  { href: '/#sobre', rotulo: 'sobre.md' },
  { href: '/#projetos', rotulo: 'projetos/' },
  { href: '/#experiencia', rotulo: 'experiencia.log' },
  { href: '/#contato', rotulo: 'contato.sh' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-3">
    <a href="/" class="font-mono text-lg font-bold text-accent" aria-label="Início">
      &lt;LucasLira/&gt;
    </a>
    <nav aria-label="Principal" class="order-3 w-full sm:order-none sm:w-auto">
      <ul class="flex gap-1 overflow-x-auto font-mono text-sm text-muted">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block rounded px-3 py-1.5 whitespace-nowrap transition hover:bg-surface hover:text-text"
            >
              {l.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href={perfil.cv}
      download
      class="rounded-lg border border-accent px-3 py-1.5 font-mono text-sm text-accent transition hover:bg-accent hover:text-bg"
    >
      Baixar CV
    </a>
  </div>
</header>

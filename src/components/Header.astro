---
import { perfil } from '../data/perfil';
import { rotaHome, textos, type Alternativas, type Lang } from '../i18n';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  lang: Lang;
  /** A mesma página no outro idioma. */
  alternativas: Alternativas;
}

const { lang, alternativas } = Astro.props;
const t = textos(lang);
const home = rotaHome(lang);

const links = [
  { id: 'topo', rotulo: t.menu.sobre },
  { id: 'experiencia', rotulo: t.menu.experiencia },
  { id: 'projetos', rotulo: t.menu.projetos },
  { id: 'stacks', rotulo: t.menu.stacks },
  { id: 'formacao', rotulo: t.menu.formacao },
  { id: 'contato', rotulo: t.menu.contato },
];
---

<header>
  <div class="container barra">
    <a href={home} class="nome" aria-label={`${perfil.nome} – ${t.ui.inicio}`}>
      {perfil.nome}
    </a>
    <div class="idioma">
      <LanguageToggle {lang} {alternativas} />
    </div>
    <nav aria-label={t.ui.menuPrincipal} data-menu>
      <ul>
        {links.map((l) => (
          <li>
            <a href={`${home}#${l.id}`}>{l.rotulo}</a>
          </li>
        ))}
        <li class="marcador" data-marcador aria-hidden="true"></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--grafite);
    background-image: var(--ruido);
    border-bottom: 1px solid var(--metal);
  }

  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 1.25rem;
    padding-block: 0.55rem;
  }

  .nome {
    color: var(--prata-2);
    font-family: var(--fonte-display), system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* No celular: nome e idioma na primeira linha, menu embaixo. */
  .idioma {
    margin-left: auto;
  }

  /* No celular o menu fica em uma linha só e rola para o lado, para o cabeçalho não ocupar a tela. */
  nav[data-menu] {
    order: 3;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  nav[data-menu]::-webkit-scrollbar {
    display: none;
  }

  ul {
    position: relative;
    display: flex;
    width: max-content;
  }

  nav a {
    display: block;
    padding: 0.55rem 0.8rem;
    color: var(--prata);
    font-family: var(--fonte-display), system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  nav a:hover,
  nav a[aria-current] {
    color: var(--prata-2);
  }

  /* Marcador bordô que desliza até a seção atual (posição vem de passagem.ts). */
  .marcador {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--w, 0px);
    height: 3px;
    background: var(--bordo-2);
    transform: translate(var(--x, 0px), var(--y, 0px));
  }

  @media (prefers-reduced-motion: no-preference) {
    .marcador {
      transition:
        transform 0.45s var(--ease-lamina),
        width 0.45s var(--ease-lamina);
    }
  }

  /* Telas largas: nome, menu e idioma na mesma linha. */
  @media (min-width: 64rem) {
    .barra {
      justify-content: space-between;
    }

    .idioma {
      order: 3;
      margin-left: 0;
    }

    nav[data-menu] {
      order: 2;
      width: auto;
      overflow: visible;
    }

    ul {
      width: auto;
      flex-wrap: wrap;
    }
  }
</style>

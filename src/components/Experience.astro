---
import { experiencias } from '../data/perfil';
---

<ol class="lista">
  {experiencias.map((e) => (
    <li>
      <p class="periodo mono">{e.periodo}</p>
      <h3>{e.cargo}</h3>
      <p class="empresa">{e.empresa}</p>
      <p class="resumo">{e.resumo}</p>
      {e.tecnologias.length > 0 && <p class="tec mono">{e.tecnologias.join(' · ')}</p>}
    </li>
  ))}
</ol>

<style>
  .lista {
    display: grid;
    gap: 2rem;
  }

  li + li {
    padding-top: 2rem;
    border-top: 1px solid var(--linha);
  }

  .periodo {
    color: var(--suave);
  }

  h3 {
    margin-top: 0.25rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .empresa {
    color: var(--destaque);
  }

  .resumo {
    margin-top: 0.6rem;
    max-width: 38rem;
  }

  .tec {
    margin-top: 0.5rem;
    color: var(--suave);
  }
</style>

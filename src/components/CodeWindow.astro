---
import { Code } from 'astro:components';
import { perfil } from '../data/perfil';

const codigo = `const lucas = {
  cargo: "${perfil.cargo}",
  foco: ["LLMs", "agentes", "automação"],
  local: "${perfil.local}",
  aprendendo: "Inteligência Artificial",
  disponivel: true,
};`;
---

<!-- Decorativo: repete o texto do hero, por isso fica oculto para leitores de tela. -->
<div
  aria-hidden="true"
  class="overflow-hidden rounded-xl border border-border bg-surface shadow-2xl shadow-accent/5"
>
  <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
    <span class="size-3 rounded-full bg-[#ff5f56]"></span>
    <span class="size-3 rounded-full bg-[#ffbd2e]"></span>
    <span class="size-3 rounded-full bg-[#27c93f]"></span>
    <span class="ml-3 font-mono text-xs text-muted">lucas.ts</span>
  </div>
  <div class="overflow-x-auto p-4 font-mono text-sm leading-relaxed [&_pre]:!bg-transparent">
    <Code code={codigo} lang="ts" theme="github-dark-default" />
  </div>
</div>

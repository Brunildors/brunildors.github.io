---
import { Icon } from 'astro-icon/components';
import { competencias } from '../data/perfil';
---

<div class="stack">
  {competencias.map((g, i) => (
    <div class="grupo" data-revelar style={`--ordem: ${i}`}>
      <h3>{g.grupo}</h3>
      <ul>
        {g.itens.map((item) => (
          <li>
            <Icon name={item.icone} size={18} aria-hidden="true" />
            <span>{item.nome}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .stack {
    display: grid;
    gap: 1.4rem 2.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--metal);
  }

  h3 {
    margin-bottom: 0.6rem;
    color: var(--prata);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  li {
    --chanfro: 7px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    background: var(--vinho);
    box-shadow: inset 0 1px 0 rgb(212 206 205 / 0.14);
    clip-path: var(--corte);
    color: var(--prata-2);
    font-size: 0.9rem;
  }

  li :global(svg) {
    flex: none;
    color: var(--prata);
  }

  @media (min-width: 52rem) {
    .stack {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

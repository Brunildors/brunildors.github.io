---
import { experiencias } from '../data/perfil';
---

<ol class="relative ml-2 space-y-10 border-l border-border pl-8">
  {experiencias.map((e) => (
    <li class="relative">
      <span
        class="absolute top-1.5 -left-[2.4rem] size-3 rounded-full border-2 border-accent bg-bg"
        aria-hidden="true"
      />
      <p class="text-sm text-muted">{e.periodo}</p>
      <h3 class="mt-1 text-xl font-semibold">{e.cargo}</h3>
      <p class="text-accent-2">{e.empresa}</p>
      <p class="mt-3 max-w-prose text-text/90">{e.resumo}</p>
      <ul class="mt-3 flex flex-wrap gap-2 font-mono text-xs text-accent">
        {e.tags.map((t) => (
          <li class="rounded bg-surface px-2 py-1">{t}</li>
        ))}
      </ul>
    </li>
  ))}
</ol>

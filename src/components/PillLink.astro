---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  icone?: string;
  /** Texto menor em fonte mono ao lado do rótulo (usuário, número, e-mail). */
  detalhe?: string;
  /** Botão preenchido em bordô: use no máximo um por trecho de tela. */
  primario?: boolean;
  /** Atributo `download` para arquivos. */
  baixar?: boolean;
}

const { href, icone, detalhe, primario = false, baixar = false } = Astro.props;
const externo = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['pilula', { primario }]}
  download={baixar || undefined}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener noreferrer' : undefined}
>
  {icone && <Icon name={icone} size={18} aria-hidden="true" />}
  <span>
    <slot />
  </span>
  {detalhe && <span class="detalhe mono suave">{detalhe}</span>}
</a>

<style>
  .pilula {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    max-width: 100%;
    border: 1.5px solid color-mix(in srgb, var(--prata) 65%, var(--grafite));
    border-radius: 999px;
    color: var(--prata-2);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .pilula:hover {
    border-color: var(--prata);
    background: var(--vinho);
  }

  .primario {
    background: var(--bordo-2);
    border-color: var(--bordo-2);
  }

  .primario:hover {
    border-color: var(--prata-2);
    background: var(--bordo-2);
    filter: brightness(1.12);
  }

  .pilula span:first-of-type {
    white-space: nowrap;
  }

  .detalhe {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: 0.85rem;
    font-weight: 400;
  }
</style>

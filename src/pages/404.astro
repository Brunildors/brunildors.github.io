---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PillLink from '../components/PillLink.astro';
import { perfil } from '../data/perfil';
---

<BaseLayout title={`Página não encontrada | ${perfil.nome}`} noindex>
  <Header />
  <main id="conteudo" class="container">
    <p class="mono terminal">$ cd {Astro.url.pathname}</p>
    <p class="mono terminal">bash: página: command not found</p>
    <h1>404: página não encontrada</h1>
    <p>O endereço que você abriu não existe ou foi movido.</p>
    <div class="botao">
      <PillLink href="/" icone="tabler:arrow-left" primario>
        Voltar ao início
      </PillLink>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    padding-block: 4rem;
    max-width: 40rem;
  }

  .terminal {
    color: var(--suave);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: 2rem;
    font-weight: 600;
  }

  .botao {
    margin-top: 1.5rem;
  }
</style>

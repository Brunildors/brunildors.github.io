---
import { projetosPublicados } from '../data/projetos';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Experience from '../components/Experience.astro';
import Stack from '../components/Stack.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const projetos = await projetosPublicados();
const destaque = projetos.find((p) => p.data.destaque);
const demais = projetos.filter((p) => p !== destaque);

const propsDoCard = (p: (typeof projetos)[number]) => ({
  slug: p.id,
  titulo: p.data.titulo,
  resumo: p.data.resumo,
  stack: p.data.stack,
  icone: p.data.icone,
  capa: p.data.capa,
  repositorio: p.data.repositorio,
  demo: p.data.demo,
});
---

<BaseLayout jsonLd>
  <Header />
  <main id="conteudo">
    <Hero />
    <Section id="experiencia" titulo="Experiência">
      <Experience />
    </Section>
    <Section id="projetos" titulo="Projetos">
      <Stack />
      {destaque && <ProjectCard {...propsDoCard(destaque)} destaque ordem={0} />}
      <ul class="vitrine">
        {demais.map((p, i) => (
          <li>
            <ProjectCard {...propsDoCard(p)} ordem={i + 1} />
          </li>
        ))}
      </ul>
    </Section>
    <Section id="formacao" titulo="Formação e cursos">
      <Education />
    </Section>
    <Section id="contato" titulo="Contato">
      <Contact />
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .vitrine {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 52rem) {
    .vitrine {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

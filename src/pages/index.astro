---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const projetos = (await getCollection('projetos', (p) => !p.data.rascunho)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<BaseLayout jsonLd>
  <Header />
  <main id="conteudo">
    <Hero />
    <Section id="sobre" titulo="Sobre">
      <About />
    </Section>
    <Section id="experiencia" titulo="Experiência">
      <Experience />
    </Section>
    <Section id="projetos" titulo="Projetos">
      <div class="projetos">
        {projetos.map((p) => (
          <ProjectItem
            slug={p.id}
            titulo={p.data.titulo}
            resumo={p.data.resumo}
            stack={p.data.stack}
            capa={p.data.capa}
            repositorio={p.data.repositorio}
            demo={p.data.demo}
          />
        ))}
      </div>
    </Section>
    <Section id="formacao" titulo="Formação e cursos">
      <Education />
    </Section>
    <Section id="contato" titulo="Contato">
      <Contact />
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .projetos {
    display: grid;
    gap: 2.5rem;
  }

  .projetos > :global(article + article) {
    padding-top: 2.5rem;
    border-top: 1px solid var(--linha);
  }
</style>

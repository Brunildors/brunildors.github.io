---
import { Font } from 'astro:assets';
import { perfil, experiencias, formacao, cursos, competencias } from '../data/perfil';
import { contatos } from '../data/redes';
import { projetosPublicados } from '../data/projetos';

const projetos = await projetosPublicados();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{perfil.nome} – Currículo</title>
    <Font cssVariable="--fonte-texto" />
    <Font cssVariable="--fonte-mono" />
  </head>
  <body>
    <main class="cv">
      <h1>{perfil.nome}</h1>
      <p class="sub">
        {perfil.cargo} · {perfil.local}
      </p>
      <p class="sub contatos">
        {contatos.map((c, i) => (
          <>
            {i > 0 && ' · '}
            {c.nome}: <a href={c.url}>{c.exibicao}</a>
          </>
        ))}
      </p>

      <h2>Resumo</h2>
      {perfil.bio.map((p) => (
        <p>{p}</p>
      ))}

      <h2>Experiência</h2>
      {experiencias.map((e) => (
        <div class="item">
          <p>
            <strong>{e.cargo}</strong>, {e.empresa} <span class="sub">({e.periodo})</span>
          </p>
          <p>{e.resumo}</p>
        </div>
      ))}

      <h2>Projetos</h2>
      <ul>
        {projetos.map((p) => (
          <li>
            <strong>{p.data.titulo}</strong>. {p.data.resumo} ({p.data.stack.join(', ')})
          </li>
        ))}
      </ul>

      <h2>Formação</h2>
      <ul>
        {formacao.map((f) => (
          <li>
            {f.curso}, {f.instituicao} ({f.periodo})
          </li>
        ))}
      </ul>

      <h2>Cursos</h2>
      <ul>
        {cursos.map((c) => (
          <li>
            {c.nome}, {c.plataforma}
          </li>
        ))}
      </ul>

      <h2>Competências</h2>
      {competencias.map((g) => (
        <p>
          <strong>{g.grupo}:</strong> {g.itens.join(', ')}
        </p>
      ))}
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 12mm;
  }

  @media print {
    .cv {
      padding: 0;
    }
  }

  html,
  body {
    margin: 0;
    background: #fff;
  }

  .cv {
    max-width: 190mm;
    margin: 0 auto;
    padding: 10mm;
    color: #111;
    font-family: var(--fonte-texto), system-ui, sans-serif;
    font-size: 10pt;
    line-height: 1.33;
  }

  .cv h1 {
    margin: 0;
    font-size: 20pt;
  }

  .cv h2 {
    margin: 10pt 0 5pt;
    padding-bottom: 2pt;
    border-bottom: 1px solid #999;
    font-size: 11pt;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cv p,
  .cv ul {
    margin: 0 0 4pt;
  }

  .cv ul {
    padding-left: 14pt;
    list-style: disc;
  }

  .cv a {
    color: #111;
  }

  .cv .sub {
    color: #444;
  }
</style>

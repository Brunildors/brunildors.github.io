---
import '../styles/global.css';
import { perfil, experiencias, formacao, cursos, stack } from '../data/perfil';
import { redesAtivas } from '../data/redes';
import { getCollection } from 'astro:content';

const projetos = (await getCollection('projetos', (p) => !p.data.rascunho)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{perfil.nome} — Currículo</title>
    <style is:global>
      @page {
        size: A4;
        margin: 14mm;
      }
      .cv {
        background: #fff;
        color: #111;
        font-size: 10.5pt;
        line-height: 1.45;
        max-width: 190mm;
        margin: 0 auto;
        padding: 10mm;
      }
      .cv h1 {
        font-size: 20pt;
        margin: 0;
      }
      .cv h2 {
        font-size: 11pt;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-bottom: 1px solid #999;
        margin: 14pt 0 6pt;
        padding-bottom: 2pt;
      }
      .cv p,
      .cv ul {
        margin: 0 0 4pt;
      }
      .cv ul {
        padding-left: 14pt;
        list-style: disc;
      }
      .cv a {
        color: #111;
        text-decoration: underline;
      }
      .cv .sub {
        color: #444;
      }
      html,
      body {
        background: #fff;
      }
    </style>
  </head>
  <body>
    <main class="cv">
      <h1>{perfil.nome}</h1>
      <p class="sub">
        {perfil.cargo} · {perfil.local}
      </p>
      <p class="sub">
        {perfil.email ?? '[TODO: e-mail público]'}
        {redesAtivas.map((r) => (
          <span>
            {' '}
            · <a href={r.url}>{r.nome}</a>
          </span>
        ))}
      </p>

      <h2>Resumo</h2>
      {perfil.bio.map((p) => (
        <p>{p}</p>
      ))}

      <h2>Experiência</h2>
      {experiencias.map((e) => (
        <div>
          <p>
            <strong>{e.cargo}</strong> — {e.empresa} <span class="sub">({e.periodo})</span>
          </p>
          <p>{e.resumo}</p>
        </div>
      ))}

      <h2>Projetos</h2>
      <ul>
        {projetos.map((p) => (
          <li>
            <strong>{p.data.titulo}</strong> — {p.data.resumo} ({p.data.stack.join(', ')})
          </li>
        ))}
      </ul>

      <h2>Formação</h2>
      <ul>
        {formacao.map((f) => (
          <li>
            {f.curso} — {f.instituicao} ({f.periodo})
          </li>
        ))}
      </ul>

      <h2>Cursos</h2>
      <ul>
        {cursos.map((c) => (
          <li>{c.nome}</li>
        ))}
      </ul>

      <h2>Competências</h2>
      {stack.map((g) => (
        <p>
          <strong>{g.grupo}:</strong> {g.itens.join(', ')}
        </p>
      ))}
    </main>
  </body>
</html>

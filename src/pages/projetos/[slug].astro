---
import ProjetoPagina from '../../components/ProjetoPagina.astro';
import { projetosPublicados } from '../../data/projetos';

export async function getStaticPaths() {
  const projetos = await projetosPublicados('pt');
  return projetos.map((projeto) => ({ params: { slug: projeto.slug }, props: { projeto } }));
}

const { projeto } = Astro.props;
---

<ProjetoPagina lang="pt" {projeto} />

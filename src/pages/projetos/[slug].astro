---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { projetosPublicados } from '../../data/projetos';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PillLink from '../../components/PillLink.astro';
import { perfil } from '../../data/perfil';

export async function getStaticPaths() {
  const projetos = await projetosPublicados();
  return projetos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={`${d.titulo} | ${perfil.nome}`} description={d.resumo}>
  <Header />
  <main id="conteudo" class="container">
    <a href="/#projetos" class="voltar">
      Todos os projetos
    </a>
    <h1>{d.titulo}</h1>
    <p class="resumo">{d.resumo}</p>

    <div class="botoes">
      {d.demo && (
        <PillLink href={d.demo} icone="tabler:player-play" primario>
          Jogar
        </PillLink>
      )}
      {d.repositorio && (
        <PillLink href={d.repositorio} icone="tabler:brand-github">
          Código no GitHub
        </PillLink>
      )}
    </div>

    {d.capa && (
      <Image
        src={d.capa}
        alt={`Tela do projeto ${d.titulo}`}
        width={900}
        height={Math.round((900 * d.capa.height) / d.capa.width)}
        loading="eager"
        fetchpriority="high"
        class="capa moldura"
      />
    )}

    <dl class="ficha">
      <div>
        <dt>Meu papel</dt>
        <dd>{d.papel}</dd>
      </div>
      {d.contexto && (
        <div>
          <dt>Contexto</dt>
          <dd>{d.contexto}</dd>
        </div>
      )}
      <div>
        <dt>Tecnologias</dt>
        <dd class="mono">{d.stack.join(' · ')}</dd>
      </div>
    </dl>

    <div class="texto">
      <Content />
    </div>

    {d.aviso && <p class="aviso">{d.aviso}</p>}
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    padding-block: 2.5rem 4rem;
    max-width: 44rem;
  }

  .voltar {
    font-size: 0.95rem;
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .resumo {
    margin-top: 0.75rem;
    font-size: 1.15rem;
    color: var(--suave);
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  main :global(.capa) {
    margin-top: 2rem;
  }

  .ficha {
    display: grid;
    gap: 0.9rem;
    margin: 2rem 0 0;
    padding-block: 1.5rem;
    border-block: 1px solid var(--linha);
  }

  .texto {
    margin-top: 2rem;
  }

  .texto :global(h2) {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .texto :global(p),
  .texto :global(ul) {
    margin-top: 0.75rem;
  }

  .texto :global(ul) {
    padding-left: 1.2rem;
    list-style: disc;
  }

  .texto :global(li) {
    margin-top: 0.4rem;
  }

  .aviso {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linha);
    color: var(--suave);
    font-size: 0.9rem;
  }
</style>

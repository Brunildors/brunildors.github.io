---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { projetosPublicados } from '../../data/projetos';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PillLink from '../../components/PillLink.astro';
import { perfil } from '../../data/perfil';

export async function getStaticPaths() {
  const projetos = await projetosPublicados();
  return projetos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={`${d.titulo} | ${perfil.nome}`} description={d.resumo}>
  <Header />
  <main id="conteudo" class="container">
    <a href="/#projetos" class="voltar">
      &larr; Todos os projetos
    </a>
    <h1>{d.titulo}</h1>
    <span class="lamina" aria-hidden="true"></span>
    <p class="resumo">{d.resumo}</p>

    <div class="botoes">
      {d.demo && (
        <PillLink href={d.demo} icone="tabler:player-play" primario>
          Jogar
        </PillLink>
      )}
      {d.repositorio && (
        <PillLink href={d.repositorio} icone="tabler:brand-github">
          Código no GitHub
        </PillLink>
      )}
    </div>

    {d.capa && (
      <Image
        src={d.capa}
        alt={`Tela do projeto ${d.titulo}`}
        width={900}
        height={Math.round((900 * d.capa.height) / d.capa.width)}
        loading="eager"
        fetchpriority="high"
        class="capa moldura"
      />
    )}

    <dl class="ficha painel">
      <div>
        <dt>Meu papel</dt>
        <dd>{d.papel}</dd>
      </div>
      {d.contexto && (
        <div>
          <dt>Contexto</dt>
          <dd>{d.contexto}</dd>
        </div>
      )}
      <div>
        <dt>Tecnologias</dt>
        <dd class="mono">{d.stack.join(' · ')}</dd>
      </div>
    </dl>

    <div class="texto">
      <Content />
    </div>

    {d.aviso && <p class="aviso">{d.aviso}</p>}
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 46rem;
    padding-block: 2.5rem 4.5rem;
  }

  .voltar {
    font-size: 0.95rem;
    color: var(--prata);
  }

  h1 {
    margin-block: 1.25rem 0.9rem;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .resumo {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: var(--prata);
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  main :global(.capa) {
    margin-top: 2rem;
    width: 100%;
  }

  .ficha {
    display: grid;
    gap: 0.9rem;
    margin: 2rem 0 0;
  }

  .texto {
    margin-top: 2rem;
  }

  .texto :global(h2) {
    margin-top: 2rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .texto :global(p),
  .texto :global(ul) {
    margin-top: 0.75rem;
  }

  .texto :global(ul) {
    padding-left: 1.2rem;
    list-style: disc;
  }

  .texto :global(li) {
    margin-top: 0.4rem;
  }

  .aviso {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--metal);
    color: var(--prata);
    font-size: 0.9rem;
  }
</style>

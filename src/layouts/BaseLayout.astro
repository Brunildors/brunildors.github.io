---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { perfil } from '../data/perfil';
import { perfisPublicos } from '../data/redes';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: boolean;
}

const {
  title = `${perfil.nome} | ${perfil.cargo}`,
  description = perfil.descricao,
  noindex = false,
  jsonLd = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const pessoa = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nome,
  jobTitle: perfil.cargo,
  address: {
    '@type': 'PostalAddress',
    addressLocality: perfil.cidade,
    addressRegion: perfil.uf,
    addressCountry: 'BR',
  },
  url: Astro.site?.href,
  sameAs: perfisPublicos,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1f1a1c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    <Font cssVariable="--fonte-display" preload />
    <Font cssVariable="--fonte-texto" preload />
    <Font cssVariable="--fonte-mono" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(pessoa)} />}

    <!-- As animações de passagem só valem com JavaScript; sem ele a página fica estática e completa. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#conteudo" class="pular">
      Pular para o conteúdo
    </a>
    <slot />
    <script>
      import '../scripts/passagem.ts';
    </script>
  </body>
</html>
